  - component: {fileID: 1764779152}
  - component: {fileID: 1764779151}
  - component: {fileID: 1764779149}
  m_Layer: 0
  m_Name: Aldric
  m_TagString: Untagged
  m_Icon: {fileID: 0}
  m_NavMeshLayer: 0
  m_StaticEditorFlags: 0
  m_IsActive: 1
--- !u!114 &1764779149
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1764779148}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 25f1887a7e5de485b948c0eacfae4b86, type: 3}
  m_Name: 
  m_EditorClassIdentifier: TopDown::TopDown.NpcDialogue
  displayName: Aldric
  verb: Talk-to
  kind: 1
  examine: Aldric, last mage of the Windspire Order. His beard has seen better winds.
  range: 1.4
  interactOffset: {x: 0, y: 0}
  clickArea: {fileID: 746601566}
  portrait: {fileID: 21300000, guid: 3045be44e61b540428c5da74de09be66, type: 3}
  introduction:
  - playerSpeaks: 0
    text: Ah! It worked... it actually worked! You're real, and you're breathing. Splendid.
  - playerSpeaks: 0
    text: Forgive the rude awakening. I am Aldric, the last mage of the Windspire Order.
  - playerSpeaks: 1
    text: Where am I? A moment ago I was asleep in my own bed!
  - playerSpeaks: 0
    text: You stand on the Windspire Peaks, high above the world of Eldmere. Do mind the edge.
  - playerSpeaks: 0
    text: A darkness is rising in the lands below. It swallows villages, forests, whole kingdoms... and none of us can stop it.
  - playerSpeaks: 0
    text: An old prophecy speaks of a hero from another world. So I opened a door between worlds... and you fell through it.
  - playerSpeaks: 1
    text: A hero? I've never even held a sword.
  - playerSpeaks: 0
    text: Every hero begins with nothing. You will learn, as they all did. But first you must survive the night up here.
  - playerSpeaks: 0
    text: My strength is spent from holding the portal open. Still, I have one gift left in me. Watch closely.
  - playerSpeaks: 0
    text: Across the gap you'll find an old woodcutter's axe. Cut some wood and build a fire, or the cold will take you.
  reminder:
  - playerSpeaks: 0
    text: Steady, hero. Listen to the wind; it is the only friend you have up here.
